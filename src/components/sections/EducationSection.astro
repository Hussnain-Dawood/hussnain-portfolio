---
const education = [
  {
    period: '2023 – 2027',
    degree: 'Bachelor of Science — Software Engineering',
    institution: 'COMSATS University Islamabad',
    status: 'In Progress',
    description:
      'Studying core Computer Science subjects including Data Structures, Algorithms, Operating Systems, Database Systems, Software Engineering, and Object-Oriented Programming. Active in tech communities and personal projects.',
    highlights: ['DSA', 'OOP', 'Database Systems', 'Software Engineering', 'OS'],
    icon: '🎓',
  },
];

const certifications = [
  { name: 'Python Programming',         org: 'University of Michigan / Coursera' },
  { name: 'Web Developers',             org: 'Johns Hopkins University / Coursera' },
  { name: 'Web Scraping',               org: 'ParseHub Academy' },
  { name: 'SEO & Freelancing',          org: 'DigiSkills.pk' },
  { name: 'Ethical Hacking Essentials', org: 'EC-Council' },
  { name: 'Product Ambassador',         org: 'Insite' },
];
---

<section class="education section section--alt" id="education" aria-label="Education and certifications">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">&#47;&#47; education</span>
      <h2 class="section-title">Education &amp; Certifications</h2>
      <p class="section-subtitle">Academic background and industry credentials.</p>
    </div>

    <!-- Degree timeline -->
    <div class="timeline edu-timeline">
      {education.map((edu, i) => (
        <div class="timeline__item" data-animate data-animate-delay="1">
          <div class="timeline__line-wrap" aria-hidden="true">
            <div class="timeline__dot">
              <span>{edu.icon}</span>
            </div>
          </div>

          <div class="timeline__card edu-card">
            <div class="timeline__card-head">
              <div>
                <span class="timeline__period">{edu.period}</span>
                <h3 class="timeline__role">{edu.degree}</h3>
                <p class="timeline__company">{edu.institution}</p>
              </div>
              <span class="timeline__badge edu-badge">{edu.status}</span>
            </div>
            <p class="timeline__desc">{edu.description}</p>
            <div class="timeline__tags">
              {edu.highlights.map(h => <span class="tag">{h}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications -->
    <div class="certs" data-animate data-animate-delay="2">
      <h3 class="certs__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        Certifications
      </h3>
      <div class="certs__grid">
        {certifications.map((cert, i) => (
          <div class="cert-card" data-animate data-animate-delay={String((i % 3) + 1)}>
            <div class="cert-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <p class="cert-card__name">{cert.name}</p>
              <p class="cert-card__org">{cert.org}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Reuse timeline styles from Experience — override card margin */
  .edu-timeline .timeline__card {
    margin-bottom: var(--sp-10);
  }

  .edu-badge {
    background: rgba(10, 122, 75, 0.12);
    color: var(--color-success);
  }

  /* Certifications */
  .certs {
    margin-top: var(--sp-4);
  }

  .certs__title {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--sp-6);
  }

  .certs__title svg {
    color: var(--color-primary);
  }

  .certs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-4);
  }

  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    padding: var(--sp-4) var(--sp-5);
    transition: box-shadow var(--t-base), border-color var(--t-base), transform var(--t-base);
  }

  .cert-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
    transform: translateY(-2px);
  }

  .cert-card__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: rgba(10, 122, 75, 0.12);
    color: var(--color-success);
    border-radius: var(--r-md);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cert-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
    max-width: none;
    margin-bottom: 2px;
  }

  .cert-card__org {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: none;
  }

  /* Reuse timeline styles */
  .timeline {
    display: flex;
    flex-direction: column;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--sp-6);
  }

  .timeline__line-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline__dot {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    background: var(--color-white);
    border: 2px solid var(--color-primary);
    border-radius: var(--r-full);
    flex-shrink: 0;
    font-size: 1.2rem;
    box-shadow: var(--shadow-sm);
  }

  .timeline__card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--r-xl);
    padding: var(--sp-6) var(--sp-8);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base), transform var(--t-base);
  }

  .timeline__card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    border-color: var(--color-primary-light);
  }

  .timeline__card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }

  .timeline__period {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--sp-1);
  }

  .timeline__role {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--sp-1);
  }

  .timeline__company {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    max-width: none;
  }

  .timeline__badge {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-muted);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-full);
  }

  .timeline__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--sp-5);
    max-width: 60ch;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-full);
  }

  @media (max-width: 600px) {
    .timeline__item {
      grid-template-columns: 40px 1fr;
      gap: var(--sp-4);
    }

    .timeline__dot {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .timeline__card {
      padding: var(--sp-5);
    }

    .certs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
