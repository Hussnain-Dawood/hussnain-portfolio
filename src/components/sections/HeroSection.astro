---
---

<section class="hero" id="hero" aria-label="Introduction">
  <div class="hero__bg-blob" aria-hidden="true"></div>

  <div class="container hero__inner">
    <!-- Left: text content -->
    <div class="hero__content">
      <span class="hero__greeting">Hello, World! &nbsp;👋</span>

      <h1 class="hero__name">
        Hussnain<br />Dawood
      </h1>

      <p class="hero__role">
        <span class="hero__role-highlight">Full Stack Developer</span>
        &amp; App Developer
      </p>

      <p class="hero__bio">
        Software Engineering student at COMSATS University Islamabad, building
        scalable MERN stack applications. Passionate about clean code, strong
        foundations in DSA, and turning ideas into fast, polished products.
      </p>

      <!-- Social links -->
      <div class="hero__socials" aria-label="Social links">
        <a
          href="https://github.com/Hussnain-Dawood"
          target="_blank"
          rel="noopener noreferrer"
          class="hero__social-link"
          aria-label="GitHub profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub
        </a>

        <a
          href="https://www.linkedin.com/in/hussnaindawood"
          target="_blank"
          rel="noopener noreferrer"
          class="hero__social-link"
          aria-label="LinkedIn profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>

        <a
          href="mailto:hussnaindawood2@gmail.com"
          class="hero__social-link"
          aria-label="Send an email"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Email
        </a>
      </div>

      <!-- CTAs -->
      <div class="hero__actions">
        <a href="#projects" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          View Projects
        </a>
        <a href="#contact" class="btn btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Contact Me
        </a>
      </div>
    </div>

    <!-- Right: code snippet card -->
    <div class="hero__code-wrap" aria-hidden="true">
      <div class="code-card">
        <!-- Window chrome -->
        <div class="code-card__header">
          <span class="code-card__dot code-card__dot--red"></span>
          <span class="code-card__dot code-card__dot--yellow"></span>
          <span class="code-card__dot code-card__dot--green"></span>
          <span class="code-card__filename">developer.js</span>
        </div>

        <!-- Code body -->
        <pre class="code-card__pre"><code class="code-card__code"><span class="cc-kw">const</span> <span class="cc-fn">developer</span> <span class="cc-op">=</span> <span class="cc-p">&#123;</span>
  <span class="cc-prop">name</span><span class="cc-p">:</span>         <span class="cc-str">'Hussnain Dawood'</span><span class="cc-p">,</span>
  <span class="cc-prop">skills</span><span class="cc-p">:</span>       <span class="cc-p">[</span><span class="cc-str">'React'</span><span class="cc-p">,</span> <span class="cc-str">'Node.js'</span><span class="cc-p">,</span>
                <span class="cc-str">'Express'</span><span class="cc-p">,</span> <span class="cc-str">'MongoDB'</span><span class="cc-p">,</span>
                <span class="cc-str">'C++'</span><span class="cc-p">,</span> <span class="cc-str">'Python'</span><span class="cc-p">],</span>
  <span class="cc-prop">hardWorker</span><span class="cc-p">:</span>   <span class="cc-bool">true</span><span class="cc-p">,</span>
  <span class="cc-prop">quickLearner</span><span class="cc-p">:</span> <span class="cc-bool">true</span><span class="cc-p">,</span>
  <span class="cc-prop">problemSolver</span><span class="cc-p">:</span> <span class="cc-bool">true</span><span class="cc-p">,</span>
<span class="cc-p">};</span>

<span class="cc-comment">// Currently seeking internships</span>
<span class="cc-comment">// &amp; entry-level opportunities</span>
</code></pre>
      </div>

      <!-- Floating badge -->
      <div class="hero__badge hero__badge--top">
        <span class="hero__badge-dot"></span>
        Available for work
      </div>
      <div class="hero__badge hero__badge--bottom">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Lahore, Pakistan
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </div>
</section>

<style>
  /* ---- Section shell ---- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--nav-height) + var(--sp-8));
    padding-bottom: var(--sp-16);
    overflow: hidden;
  }

  .hero__bg-blob {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle at 60% 40%,
      rgba(30, 95, 204, 0.10) 0%,
      rgba(77, 133, 224, 0.05) 45%,
      transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }

  /* ---- Left column ---- */
  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__greeting {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-primary);
    background: var(--color-primary-muted);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-5);
    animation: fadeInUp 0.5s ease 0s both;
  }

  .hero__name {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: var(--sp-4);
    animation: fadeInUp 0.6s ease 0.1s both;
  }

  .hero__role {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: var(--color-text-muted);
    font-weight: 400;
    max-width: none;
    margin-bottom: var(--sp-5);
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .hero__role-highlight {
    color: var(--color-primary);
    font-weight: 600;
  }

  .hero__bio {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 48ch;
    margin-bottom: var(--sp-8);
    animation: fadeInUp 0.6s ease 0.3s both;
  }

  /* Social links */
  .hero__socials {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-8);
    animation: fadeInUp 0.6s ease 0.4s both;
  }

  .hero__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.45rem 0.85rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1.5px solid var(--color-border);
    border-radius: var(--r-full);
    text-decoration: none;
    transition: all var(--t-base);
    background: var(--color-white);
  }

  .hero__social-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-muted);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  /* CTAs */
  .hero__actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    animation: fadeInUp 0.6s ease 0.5s both;
  }

  /* ---- Right column: code card ---- */
  .hero__code-wrap {
    position: relative;
    animation: fadeInRight 0.8s ease 0.3s both;
  }

  /* Code card */
  .code-card {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    font-family: var(--font-mono);
  }

  .code-card__header {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.75rem 1.1rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--code-border);
  }

  .code-card__dot {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
    flex-shrink: 0;
  }

  .code-card__dot--red    { background: var(--code-dot-red); }
  .code-card__dot--yellow { background: var(--code-dot-yellow); }
  .code-card__dot--green  { background: var(--code-dot-green); }

  .code-card__filename {
    margin-left: var(--sp-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .code-card__pre {
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    line-height: 1.8;
  }

  .code-card__code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: pre;
  }

  /* Syntax colours */
  .cc-kw      { color: var(--code-kw); font-weight: 500; }
  .cc-fn      { color: var(--code-fn); }
  .cc-op      { color: var(--code-punct); }
  .cc-p       { color: var(--code-punct); }
  .cc-prop    { color: var(--code-prop); }
  .cc-str     { color: var(--code-str); }
  .cc-bool    { color: var(--code-bool); font-weight: 500; }
  .cc-comment { color: var(--code-line-num); font-style: italic; }

  /* Floating badges */
  .hero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--r-full);
    padding: 0.4rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
  }

  .hero__badge--top {
    top: -14px;
    right: 24px;
  }

  .hero__badge--bottom {
    bottom: -14px;
    left: 24px;
    color: var(--color-text-muted);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    background: var(--code-dot-green);
    border-radius: var(--r-full);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  /* Scroll hint */
  .hero__scroll-hint {
    position: absolute;
    bottom: var(--sp-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: fadeInUp 1s ease 1s both;
  }

  .hero__scroll-hint svg {
    animation: bounce 2s ease-in-out infinite;
  }

  /* ---- Keyframe animations ---- */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(40, 200, 64, 0.4); }
    50%       { box-shadow: 0 0 0 6px rgba(40, 200, 64, 0); }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-12);
    }

    .hero__code-wrap {
      order: -1;
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }

    .hero__badge--top {
      right: 12px;
    }

    .hero__scroll-hint {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      flex-direction: column;
      width: 100%;
    }

    .hero__actions .btn {
      justify-content: center;
    }

    .code-card__pre {
      padding: 1rem;
    }
  }
</style>
