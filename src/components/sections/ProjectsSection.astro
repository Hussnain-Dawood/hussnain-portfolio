---
const projects = [
  {
    title: 'Online Appointment System',
    description:
      'Full-stack booking platform featuring automated scheduling, real-time availability, and secure JWT-based authentication. Improved booking efficiency by approximately 40% compared to manual workflows.',
    tags: ['React', 'Node.js', 'Express.js', 'MongoDB', 'JWT'],
    highlight: '~40% efficiency gain',
    highlightIcon: '📈',
    type: 'Full Stack',
    emoji: '📅',
  },
  {
    title: 'Car Rental System',
    description:
      'Database-driven vehicle rental management system with user registration, vehicle inventory tracking, booking management, and a full-featured admin panel for fleet operations.',
    tags: ['PHP', 'MySQL', 'HTML', 'CSS', 'JavaScript'],
    highlight: 'Admin dashboard',
    highlightIcon: '🗂️',
    type: 'Full Stack',
    emoji: '🚗',
  },
  {
    title: 'Car Parking System',
    description:
      'C++ simulation of a real-world parking lot, implementing vehicle check-in/check-out, slot tracking, and dynamic fee calculation. Built to demonstrate OOP principles and DSA application.',
    tags: ['C++', 'OOP', 'DSA', 'File I/O'],
    highlight: 'DSA showcase',
    highlightIcon: '🏗️',
    type: 'Systems',
    emoji: '🅿️',
  },
  {
    title: 'Freelancing Platform',
    description:
      'End-to-end freelancing marketplace connecting clients and freelancers. Features service listings, messaging, and profile management. Gained 1,000+ users within its first month of launch.',
    tags: ['HTML', 'CSS', 'JavaScript', 'PHP'],
    highlight: '100+ users in month 1',
    highlightIcon: '🚀',
    type: 'Full Stack',
    emoji: '💼',
  },
];
---

<section class="projects section" id="projects" aria-label="Projects">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">&#47;&#47; work</span>
      <h2 class="section-title">Featured Projects</h2>
      <p class="section-subtitle">
        A selection of things I've built — from real-world applications to systems programming.
      </p>
    </div>

    <div class="projects__grid">
      {projects.map((project, i) => (
        <article
          class="project-card"
          data-animate
          data-animate-delay={String((i % 2) + 1)}
        >
          <div class="project-card__top">
            <div class="project-card__header">
              <span class="project-card__emoji" aria-hidden="true">{project.emoji}</span>
              <span class="project-card__type">{project.type}</span>
            </div>
            <h3 class="project-card__title">{project.title}</h3>
            <p class="project-card__desc">{project.description}</p>
          </div>

          <div class="project-card__bottom">
            {project.highlight && (
              <div class="project-card__highlight">
                <span aria-hidden="true">{project.highlightIcon}</span>
                {project.highlight}
              </div>
            )}
            <div class="project-card__tags">
              {project.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--sp-6);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--r-2xl);
    padding: var(--sp-8);
    transition: box-shadow var(--t-base), transform var(--t-base), border-color var(--t-base);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
    opacity: 0;
    transition: opacity var(--t-base);
  }

  .project-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-6px);
    border-color: var(--color-primary-light);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-card__top {
    margin-bottom: var(--sp-6);
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
  }

  .project-card__emoji {
    font-size: 2.2rem;
    line-height: 1;
  }

  .project-card__type {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-muted);
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-full);
    letter-spacing: 0.04em;
  }

  .project-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--sp-3);
    line-height: 1.25;
  }

  .project-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: none;
  }

  .project-card__bottom {}

  .project-card__highlight {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-success);
    background: rgba(10, 122, 75, 0.10);
    padding: 0.3rem 0.75rem;
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-full);
    transition: all var(--t-fast);
    font-family: var(--font-mono);
  }

  .tag:hover {
    background: var(--color-primary-muted);
    color: var(--color-primary);
    border-color: var(--color-primary-light);
  }

  @media (max-width: 768px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
