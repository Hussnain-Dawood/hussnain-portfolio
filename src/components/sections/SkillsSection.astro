---
const skillGroups = [
  {
    category: 'Languages',
    icon: '💻',
    skills: ['JavaScript', 'TypeScript', 'Python', 'C++', 'SQL'],
  },
  {
    category: 'Frontend',
    icon: '🎨',
    skills: ['React.js', 'Flutter', 'HTML5', 'CSS3'],
  },
  {
    category: 'Backend',
    icon: '⚙️',
    skills: ['Node.js', 'Express.js', 'MongoDB', 'REST APIs'],
  },
  {
    category: 'Dev Tools',
    icon: '🛠️',
    skills: ['Git & GitHub', 'Postman', 'JIRA', 'Selenium'],
  },
  {
    category: 'Concepts',
    icon: '📐',
    skills: ['DSA', 'OOP', 'MVC', 'SEO'],
  },
];
---

<section class="skills section" id="skills" aria-label="Technical skills">
  <div class="container">
    <div class="section-header" data-animate>
      <span class="section-label">&#47;&#47; skills</span>
      <h2 class="section-title">What I Work With</h2>
      <p class="section-subtitle">
        A broad toolkit spanning languages, frameworks, databases, and best practices.
      </p>
    </div>

    <div class="skills__grid">
      {skillGroups.map((group, i) => (
        <div
          class="skills__group"
          data-animate
          data-animate-delay={String(i + 1)}
        >
          <div class="skills__group-header">
            <span class="skills__group-icon" aria-hidden="true">{group.icon}</span>
            <h3 class="skills__group-title">{group.category}</h3>
          </div>
          <div class="skills__chips">
            {group.skills.map(skill => (
              <span class="skill-chip">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--sp-5);
  }

  .skills__group {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--r-xl);
    padding: var(--sp-6);
    transition: box-shadow var(--t-base), transform var(--t-base), border-color var(--t-base);
  }

  .skills__group:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-primary-light);
  }

  .skills__group-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .skills__group-icon {
    font-size: 1.35rem;
    line-height: 1;
  }

  .skills__group-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .skill-chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-primary);
    background: var(--color-primary-muted);
    border: 1px solid rgba(30, 95, 204, 0.20);
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-full);
    transition: background var(--t-fast), color var(--t-fast), transform var(--t-fast);
  }

  .skill-chip:hover {
    background: var(--color-primary);
    color: var(--color-white);
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .skills__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 400px) {
    .skills__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
